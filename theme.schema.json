{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme.schema.json",
  "title": "Inkling theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "fonts", "light", "dark"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "fonts": { "$ref": "#/$defs/fonts" },
    "light": { "$ref": "#/$defs/mode" },
    "dark": { "$ref": "#/$defs/mode" },
    "shape": { "$ref": "#/$defs/shape" },
    "brand": { "$ref": "#/$defs/brand" }
  },
  "$defs": {
    "length": {
      "type": "string",
      "description": "A CSS length in px or rem.",
      "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px|rem)$"
    },
    "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
    "shape": {
      "type": "object",
      "description": "Optional overrides of Elanor's border widths, radii, and shadows. Anything left out keeps Elanor's value.",
      "additionalProperties": false,
      "properties": {
        "borderWidth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": { "$ref": "#/$defs/length", "description": "Separators and rules." },
            "medium": {
              "$ref": "#/$defs/length",
              "description": "Focus offsets and accent rules."
            },
            "large": { "$ref": "#/$defs/length", "description": "Focus rings." },
            "default": { "$ref": "#/$defs/length", "description": "Control and card outlines." }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": {
              "$ref": "#/$defs/length",
              "description": "Buttons, fields, chips, menus, and popups."
            },
            "medium": { "$ref": "#/$defs/length", "description": "Dialogs." },
            "large": { "$ref": "#/$defs/length" }
          }
        },
        "shadows": { "type": "boolean", "description": "False removes popup and sticky shadows." }
      }
    },
    "brand": {
      "type": "object",
      "description": "Optional logo shown before the product name, drawn in the text color.",
      "additionalProperties": false,
      "required": ["logo", "logoAspectRatio"],
      "properties": {
        "logo": {
          "type": "string",
          "description": "A base64 SVG data URI; its shape is used as a mask.",
          "maxLength": 32000,
          "pattern": "^data:image/svg\\+xml;base64,[A-Za-z0-9+/]+={0,2}$"
        },
        "logoAspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width divided by height."
        }
      }
    },
    "color": {
      "type": "string",
      "description": "An OKLCH CSS color, optionally with alpha.",
      "pattern": "^oklch\\(\\s*(?:(?:\\d+(?:\\.\\d+)?|\\.\\d+)%|(?:\\d+(?:\\.\\d+)?|\\.\\d+))\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)\\s+-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:deg)?(?:\\s*\\/\\s*(?:(?:\\d+(?:\\.\\d+)?|\\.\\d+)%|(?:\\d+(?:\\.\\d+)?|\\.\\d+)))?\\s*\\)$"
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imports", "prose", "heading", "ui", "code"],
      "properties": {
        "imports": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[^\\s\\\\\"'(){}]*)?$"
          }
        },
        "prose": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "ui": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "weights": {
          "type": "object",
          "description": "Optional overrides of Elanor's three weights: running text, app headings, and labels or emphasis.",
          "additionalProperties": false,
          "properties": {
            "normal": { "$ref": "#/$defs/weight" },
            "semiBold": { "$ref": "#/$defs/weight" },
            "bold": { "$ref": "#/$defs/weight" }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "border", "text"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "hover", "border", "text"],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "hover": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" }
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "text",
        "comment",
        "keyword",
        "title",
        "attribute",
        "string",
        "symbol",
        "addition",
        "deletion",
        "invalid"
      ],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "comment": { "$ref": "#/$defs/color" },
        "keyword": { "$ref": "#/$defs/color" },
        "title": { "$ref": "#/$defs/color" },
        "attribute": { "$ref": "#/$defs/color" },
        "string": { "$ref": "#/$defs/color" },
        "symbol": { "$ref": "#/$defs/color" },
        "addition": { "$ref": "#/$defs/color" },
        "deletion": { "$ref": "#/$defs/color" },
        "invalid": { "$ref": "#/$defs/color" }
      }
    },
    "mermaid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "primary",
        "primaryText",
        "primaryBorder",
        "line",
        "secondary",
        "tertiary",
        "note",
        "noteText"
      ],
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "primary": { "$ref": "#/$defs/color" },
        "primaryText": { "$ref": "#/$defs/color" },
        "primaryBorder": { "$ref": "#/$defs/color" },
        "line": { "$ref": "#/$defs/color" },
        "secondary": { "$ref": "#/$defs/color" },
        "tertiary": { "$ref": "#/$defs/color" },
        "note": { "$ref": "#/$defs/color" },
        "noteText": { "$ref": "#/$defs/color" }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "surface",
        "surfaceMuted",
        "editorBackground",
        "editorActiveLine",
        "text",
        "muted",
        "border",
        "borderStrong",
        "accent",
        "accentContrast",
        "accentSoft",
        "focusRing",
        "danger",
        "scrim",
        "participantText",
        "presence",
        "states",
        "visibility",
        "syntax",
        "mermaid"
      ],
      "properties": {
        "page": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "surfaceMuted": { "$ref": "#/$defs/color" },
        "editorBackground": { "$ref": "#/$defs/color" },
        "editorActiveLine": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "borderStrong": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentContrast": { "$ref": "#/$defs/color" },
        "accentSoft": { "$ref": "#/$defs/color" },
        "focusRing": { "$ref": "#/$defs/color" },
        "danger": { "$ref": "#/$defs/color" },
        "scrim": { "$ref": "#/$defs/color" },
        "selection": {
          "type": "object",
          "description": "Optional text selection colors. Without them, selections tint the background with the focus ring.",
          "additionalProperties": false,
          "required": ["background", "text"],
          "properties": {
            "background": { "$ref": "#/$defs/color" },
            "text": { "$ref": "#/$defs/color" }
          }
        },
        "participantText": { "$ref": "#/$defs/color" },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lightness", "chroma", "hueOffset"],
          "properties": {
            "lightness": { "type": "number", "minimum": 0 },
            "chroma": { "type": "number", "minimum": 0 },
            "hueOffset": { "type": "number" }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["draft", "discussion", "published", "accepted", "implemented", "abandoned"],
          "properties": {
            "draft": { "$ref": "#/$defs/state" },
            "discussion": { "$ref": "#/$defs/state" },
            "published": { "$ref": "#/$defs/state" },
            "accepted": { "$ref": "#/$defs/state" },
            "implemented": { "$ref": "#/$defs/state" },
            "abandoned": { "$ref": "#/$defs/state" }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["public", "private", "confidential"],
          "properties": {
            "public": { "$ref": "#/$defs/visibility" },
            "private": { "$ref": "#/$defs/visibility" },
            "confidential": { "$ref": "#/$defs/visibility" }
          }
        },
        "syntax": { "$ref": "#/$defs/syntax" },
        "mermaid": { "$ref": "#/$defs/mermaid" }
      }
    }
  }
}
