{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkling",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "INKLING_WORKSPACE",
        "class_name": "WorkspaceDurableObject",
      },
      {
        "name": "INKLING_DOCUMENTS",
        "class_name": "DocumentDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDurableObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DocumentDurableObject"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "INKLING_OBJECTS",
      "bucket_name": "inkling-objects",
      "preview_bucket_name": "inkling-objects-preview",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "node_modules/@earendil-works/inkling-frontend/dist",
    "not_found_handling": "single-page-application",
    // The Worker routes every request and serves the frontend itself when no route matches, so
    // redirects for legacy RFC URLs and protected links are never shadowed by the SPA fallback.
    "run_worker_first": ["/*"],
  },
}
